<?xml version="1.0" encoding="UTF-8"?>
<!--
  Connector-source-triggered flow template (e.g. salesforce:on-modified-object-listener,
  kafka:listener). The source itself starts the flow; no scheduler / http listener.
  Replace __TOKENS__ and the flow body.
  See: references/flow-templates/README.md
-->
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:__PREFIX__="__NAMESPACE__"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        __NAMESPACE__ __SCHEMA_LOCATION__
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <configuration-properties file="config.yaml"
        doc:name="Configuration Properties"
        doc:description="Loads externalized configuration from config.yaml" />

    <__PREFIX__:__CONFIG_ELEMENT__ name="__CONFIG_NAME__"
        doc:name="__PREFIX__ Config"
        doc:description="__PREFIX__ connection (__PROVIDER_NAME__ auth)">
        <__PREFIX__:__PROVIDER_ELEMENT__
            __REQUIRED_FIELD__="${__CONFIG_KEY_FOR_FIELD__}" />
    </__PREFIX__:__CONFIG_ELEMENT__>

    <flow name="__FLOW_NAME__"
        doc:name="__FLOW_DISPLAY_NAME__"
        doc:description="__FLOW_DESCRIPTION__">

        <!--
          The connector source IS the trigger. Read tmp/connector-metadata/<nick>-<source>.json
          for required attributes. Common shapes:
            <salesforce:on-modified-object-listener config-ref="..." objectType="Account">
            <kafka:listener config-ref="..." topic="..."/>
        -->
        <__PREFIX__:__SOURCE_ELEMENT__ config-ref="__CONFIG_NAME__"
            __SOURCE_REQUIRED_ATTR__="__SOURCE_REQUIRED_VALUE__"
            doc:name="__SOURCE_DISPLAY_NAME__"
            doc:description="Listens for __SOMETHING__"/>

        <logger level="INFO"
            message="#[output text/plain --- 'Received event: ' ++ (payload as String default 'no payload')]"
            doc:name="Log Event"
            doc:description="Records that an event arrived" />

        <error-handler>
            <on-error-propagate type="ANY"
                doc:name="On Error"
                doc:description="Logs the error and propagates upstream">
                <logger level="ERROR"
                    message="#[output text/plain --- 'Flow error: ' ++ (error.description default 'no description')]"
                    doc:name="Log Error Detail"
                    doc:description="Logs the error for debugging" />
            </on-error-propagate>
        </error-handler>

    </flow>
</mule>
